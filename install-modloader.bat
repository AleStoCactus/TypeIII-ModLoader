@echo off
rem Type III Mod Loader 1.0.0 - Windows installer
rem
rem Put this file in the Type III game folder and double-click it.
rem   install-modloader.bat             install or update
rem   install-modloader.bat uninstall   remove the mod loader (your mods folder is kept)
rem   add -y to answer "yes" to every question
rem
rem Everything needed is embedded at the end of this file.
setlocal
set "ML_SELF=%~f0"
set "ML_DIR=%~dp0"
set "ML_ARGS=%*"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$t=[IO.File]::ReadAllText($env:ML_SELF); $p=$t.Split([string[]]@('##'+'PS'+'##'), [StringSplitOptions]::None); $Payload=$p[2]; iex $p[1]"
set "ML_RC=%ERRORLEVEL%"
echo.
pause
exit /b %ML_RC%
##PS##
$ErrorActionPreference = 'Stop'
$Version = '1.0.0'
$GameDir = $env:ML_DIR.TrimEnd('\')
$ArgList = "$env:ML_ARGS".ToLower().Split(' ', [StringSplitOptions]::RemoveEmptyEntries)
$Uninstall = ($ArgList -contains 'uninstall') -or ($ArgList -contains '--uninstall') -or ($ArgList -contains '/uninstall')
$Yes = ($ArgList -contains '-y') -or ($ArgList -contains '/y') -or ($ArgList -contains '--yes')

function Ask([string]$Question) {
    if ($Yes) { return $true }
    $answer = Read-Host "$Question [y/N]"
    return ($answer -match '^[yYsS]')
}

function Find-Game {
    Get-ChildItem -LiteralPath $GameDir -File | Where-Object {
        ($_.Name -notmatch 'modloader') -and (
            ($_.Extension -eq '.pck') -or
            ($_.Extension -eq '.exe' -and $_.Name -match '^type\s*iii')
        )
    } | Select-Object -First 1
}

function Has-ModLoader([string]$Path) {
    if (-not (Test-Path -LiteralPath $Path)) { return $false }
    return ([IO.File]::ReadAllText($Path) -match 'ModLoader=')
}

Write-Host "=== Type III Mod Loader $Version ==="
Write-Host "Game folder: $GameDir"
Write-Host ""

$game = Find-Game
if ($null -eq $game) {
    Write-Host "WARNING: no Type III executable found in this folder."
    Write-Host "This file must be placed in the game folder (next to the game .exe)."
    if (-not (Ask "Continue anyway?")) { Write-Host "Cancelled."; exit 1 }
} else {
    Write-Host "Game found: $($game.Name)"
}

$cfg = Join-Path $GameDir 'override.cfg'

if ($Uninstall) {
    if (-not (Ask "Remove the mod loader? (the mods folder is kept)")) { Write-Host "Cancelled."; exit 1 }
    if (Has-ModLoader $cfg) {
        if (Test-Path -LiteralPath "$cfg.bak") {
            Move-Item -LiteralPath "$cfg.bak" -Destination $cfg -Force
            Write-Host "  ~ override.cfg (your original file was restored)"
        } else {
            Remove-Item -LiteralPath $cfg -Force
            Write-Host "  - override.cfg"
        }
    }
    foreach ($rel in @('modloader', 'MODDING_README.md', 'modding\extract_scripts.py')) {
        $target = Join-Path $GameDir $rel
        if (Test-Path -LiteralPath $target) {
            Remove-Item -LiteralPath $target -Recurse -Force
            Write-Host "  - $rel"
        }
    }
    $modding = Join-Path $GameDir 'modding'
    if ((Test-Path -LiteralPath $modding) -and -not (Get-ChildItem -LiteralPath $modding -Force)) {
        Remove-Item -LiteralPath $modding -Force
    }
    Write-Host ""
    Write-Host "Mod loader removed. The game is vanilla again (mods was kept)."
    exit 0
}

$tmp = Join-Path ([IO.Path]::GetTempPath()) ('TypeIII-ModLoader-' + [guid]::NewGuid().ToString('N'))
New-Item -ItemType Directory -Path $tmp | Out-Null
try {
    $zip = Join-Path $tmp 'payload.zip'
    [IO.File]::WriteAllBytes($zip, [Convert]::FromBase64String($Payload))
    $src = Join-Path $tmp 'files'
    Expand-Archive -LiteralPath $zip -DestinationPath $src

    Write-Host "Installing:"
    # Mod loader files: always updated.
    Get-ChildItem -LiteralPath $src -Recurse -File | Sort-Object FullName | ForEach-Object {
        $rel = $_.FullName.Substring($src.Length + 1)
        if ($rel -like 'mods\*' -or $rel -eq 'override.cfg') { return }
        $dst = Join-Path $GameDir $rel
        New-Item -ItemType Directory -Force -Path (Split-Path -Parent $dst) | Out-Null
        Copy-Item -LiteralPath $_.FullName -Destination $dst -Force
        Write-Host "  + $rel"
    }

    # Example mods: installed only if not already there.
    $modsDst = Join-Path $GameDir 'mods'
    New-Item -ItemType Directory -Force -Path $modsDst | Out-Null
    Get-ChildItem -LiteralPath (Join-Path $src 'mods') -Directory | ForEach-Object {
        $d = Join-Path $modsDst $_.Name
        if (Test-Path -LiteralPath $d) {
            Write-Host "  = mods\$($_.Name) (already there, kept)"
        } else {
            Copy-Item -LiteralPath $_.FullName -Destination $d -Recurse
            Write-Host "  + mods\$($_.Name)"
        }
    }

    # override.cfg: hooks the mod loader into the game.
    $ours = [IO.File]::ReadAllText((Join-Path $src 'override.cfg'))
    if ((Test-Path -LiteralPath $cfg) -and -not (Has-ModLoader $cfg)) {
        $bak = "$cfg.bak"
        if (Test-Path -LiteralPath $bak) { $bak = "$cfg.bak." + (Get-Date -Format 'yyyyMMddHHmmss') }
        Copy-Item -LiteralPath $cfg -Destination $bak
        [IO.File]::AppendAllText($cfg, "`r`n" + $ours)
        Write-Host "  + override.cfg (added to your existing file, backup: $(Split-Path -Leaf $bak))"
    } else {
        [IO.File]::WriteAllText($cfg, $ours)
        Write-Host "  + override.cfg"
    }
} finally {
    Remove-Item -LiteralPath $tmp -Recurse -Force -ErrorAction SilentlyContinue
}

Write-Host ""
Write-Host "Done! Start the game: your mods are in Settings > Mod."
Write-Host "Put new mods in: $modsDst"
Write-Host "Guide: MODDING_README.md - Uninstall: install-modloader.bat uninstall"
exit 0
